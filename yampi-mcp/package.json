{
  "name": "yampi-mcp",
  "version": "0.1.0",
  "description": "Remote MCP server for Yampi stores, hosted on Cloudflare",
  "license": "MIT",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run --exclude test/integration.test.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run test/integration.test.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "agents": "^0.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.153.0"
  }
}
